@startuml Component Diagram
!theme plain

title PokeAMI — Component Diagram

package "API Layer" {
    [FastAPI Application] as API
    [Health Router] as Health
    [Meters Router] as Meters
    [Readings Router] as Readings
    [Usage Points Router] as UP
    [Reading Types Router] as RT
    [Analytics Router] as Analytics
    [Delivery Promises Router] as DP
    [Auth Middleware] as Auth
}

package "Simulation Layer" {
    [SimulatorEngine] as Engine
    [Data Generator] as DG
    [LoadModel (stub)] as LM
}

package "Emulated Devices" {
    [Meter Park] as MP
    [SmartMeter] as SM
}

package "Emulated Infrastructure" {
    [Headend (HES)] as HES
    [MDM (VEE)] as MDM
    [Analytics Engine] as AE
    [Delivery Manager] as DM
    [Comm Network] as CN
}

API --> Auth : validates
API --> Engine : queries

Health --> Engine
Meters --> Engine
Readings --> Engine
UP --> Engine
RT --> Engine
Analytics --> Engine
DP --> Engine

Engine --> HES : raw data
Engine --> MDM : validated data
Engine --> AE : analytics
Engine --> DM : on-demand reads

DG -down-> MP : <<ReadingSource>>
LM .down.> MP : <<ReadingSource>> (future)
MP --> SM : wraps meters

SM -right-> CN : comm path
CN -right-> HES : data transport
HES --> MP : meter inventory
MDM --> HES : raw readings
AE --> HES : raw readings
DM --> HES : on-demand collection
DM --> CN : comm simulation
DM --> MDM : validated reads

@enduml
